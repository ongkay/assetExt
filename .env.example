# Extension API base URL for local development.
VITE_EXT_API_BASE_URL=http://localhost:3000

# Release/build version written into both built extension manifests and artifact names.
TVLINK_EXTENSION_VERSION=2.0.6

# Release only: minimum version written into extension_app_configs.minimum_version.
TVLINK_RELEASE_MINIMUM_VERSION=2.0.0

# Release only: public bucket that stores the extension zip artifacts.
TVLINK_RELEASE_STORAGE_BUCKET=extension-downloads

# Release only: InsForge project and service credential.
NEXT_PUBLIC_INSFORGE_URL=
INSFORGE_SERVICE_KEY=
